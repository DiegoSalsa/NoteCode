{
  "name": "notecode",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:erp": "node scripts/verify-erp.mjs",
    "test:commercial:db": "node scripts/commercial-test-db.mjs prepare",
    "test:commercial": "vitest run --config vitest.commercial.config.ts",
    "test:e2e": "playwright test",
    "test:commercial:restore": "node scripts/commercial-test-db.mjs backup"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.76",
    "@ai-sdk/react": "^3.0.312",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "ai": "^6.0.309",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.555.0",
    "next": "^16.4.2",
    "prisma": "^6.19.3",
    "react": "~19.1.10",
    "react-dom": "~19.1.10",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
