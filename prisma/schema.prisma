  crawl           SeoCrawl     @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  fromPageId      String?      @map("from_page_id")
  fromPage        SeoCrawlPage? @relation("CrawlLinkFrom", fields: [fromPageId], references: [id], onDelete: SetNull)
  fromUrl         String       @map("from_url")
  toUrl           String       @map("to_url")
  toNormalizedUrl String       @map("to_normalized_url")
  internal        Boolean      @default(true)

  @@index([crawlId, toNormalizedUrl])
  @@index([fromPageId])
  @@map("seo_crawl_links")
}

model SeoCrawlSitemap {
  id        String   @id @default(uuid())
  crawlId   String   @map("crawl_id")
  crawl     SeoCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url       String
  status    String
  kind      String   @default("sitemap")
  urlCount  Int      @default(0) @map("url_count")
  error     String?

  @@index([crawlId])
  @@map("seo_crawl_sitemaps")
}

model SeoCrawlIssue {
  id            String   @id @default(uuid())
  crawlId       String   @map("crawl_id")
  crawl         SeoCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  seoProjectId  String   @map("seo_project_id")
  ruleKey       String   @map("rule_key")
  severity      String
  category      String
  identityKey   String   @map("identity_key")
  normalizedUrl String?  @map("normalized_url")
  url           String?
  message       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([crawlId, identityKey])
  @@index([crawlId, severity])
  @@index([seoProjectId, ruleKey])
  @@index([normalizedUrl])
  @@map("seo_crawl_issues")
}

model SeoAlert {
  id           String    @id @default(uuid())
  seoProjectId String    @map("seo_project_id")
  seoProject   SeoProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  crawlId      String?   @map("crawl_id")
  crawl        SeoCrawl? @relation(fields: [crawlId], references: [id], onDelete: SetNull)
  type         String
  severity     String
  identityKey  String    @map("identity_key")
  title        String
  message      String
  status       String    @default("open")
  url          String?
  ruleKey      String?   @map("rule_key")
  taskId       String?   @map("task_id")
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([seoProjectId, status, createdAt])
  @@index([seoProjectId, identityKey])
  @@index([taskId])
  @@map("seo_alerts")
}
