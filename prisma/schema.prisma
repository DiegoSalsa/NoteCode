generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id            String              @id @default(uuid())
  name          String
  email         String?
  phone         String?
  company       String?
  taxId         String?             @map("tax_id")
  address       String?
  website       String?
  status        String              @default("Activo")
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")
  projects      Project[]
  contacts      Contact[]
  opportunities Opportunity[]
  quotes        Quote[]
  invoices      Invoice[]
  contracts     SupportContract[]
  tickets       SupportTicket[]
  portalTokens  ClientPortalToken[]

  @@index([name])
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model Project {
  id              String       @id @default(uuid())
  name            String
  description     String?
  visibility      String       @default("COMPANY")
  personalOwnerId String?      @map("personal_owner_id")
  personalOwner   UserProfile? @relation("PersonalProjectOwner", fields: [personalOwnerId], references: [userId], onDelete: Cascade)
  status          String       @default("En progreso")
  agreedAmount    Float        @default(0) @map("agreed_amount")
  currency        String       @default("CLP")
  budgetHours     Float        @default(0) @map("budget_hours")
  budgetCost      Float        @default(0) @map("budget_cost")
  startDate            DateTime?    @map("start_date")
  targetDate           DateTime?    @map("target_date")
  ownerId              String?      @map("owner_id")
  owner                TeamMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  clientId             String?      @map("client_id")
  client               Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  objective            String?
  specificObjectives   String?      @map("specific_objectives")
  scope                String?
  exclusions           String?
  priority             String       @default("Media")
  tags                 String[]     @default([])
  templateKey          String?      @map("template_key")
  version              Int          @default(1)
  sortOrder            Int          @default(0) @map("sort_order")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")
  deletedById          String?      @map("deleted_by_id")

  statusLogs       ProjectStatusLog[]
  requirements     ProjectRequirement[]
  tasks            ProjectTask[]
  techs            ProjectTech[]
  vaultCredentials Credential[]
  notes            Note[]
  documents        Document[]
  invoices         Invoice[]
  assignments      ProjectAssignment[]
  timeEntries      TimeEntry[]
  expenses         Expense[]
  approvals        ClientApproval[]
  tickets          SupportTicket[]
  contracts        SupportContract[]
  purchaseOrders   PurchaseOrder[]
  quotes           Quote[]
  portalTokens     ClientPortalToken[]
  decisions        ProjectDecision[]
  risks            ProjectRisk[]
  milestones       ProjectMilestone[]
  relatedFrom      ProjectRelation[] @relation("ProjectRelationFrom")
  relatedTo        ProjectRelation[] @relation("ProjectRelationTo")
  members          ProjectMember[]
  customFields     CustomField[]
  savedViews       SavedView[]
  seoProject       SeoProject?

  @@index([clientId])
  @@index([ownerId])
  @@index([visibility, personalOwnerId])
  @@index([status])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectStatusLog {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("project_status_logs")
}

model ProjectRequirement {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code          String    @default("")
  description   String
  category      String    @default("Funcional")
  priority      String    @default("Media")
  completed     Boolean   @default(false)
  clientVisible Boolean   @default(false) @map("client_visible")
  sortOrder     Int       @default(0) @map("sort_order")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedById   String?   @map("deleted_by_id")

  @@index([projectId, deletedAt])
  @@index([projectId, sortOrder])
  @@index([completed])
  @@index([priority])
  @@map("project_requirements")
}

model ProjectTask {
  id            String      @id @default(uuid())
  projectId     String      @map("project_id")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        String      @default("Por hacer")
  priority      String      @default("Media")
  dueDate       DateTime?   @map("due_date")
  clientVisible Boolean     @default(false) @map("client_visible")
  sortOrder     Int         @default(0) @map("sort_order")
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")
  deletedById   String?     @map("deleted_by_id")
  timeEntries   TimeEntry[]

  @@index([projectId, deletedAt])
  @@index([projectId, status, sortOrder])
  @@index([priority])
  @@index([dueDate])
  @@map("project_tasks")
}

model ProjectTech {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  category    String    @default("Frontend")
  sortOrder   Int       @default(0) @map("sort_order")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([projectId, deletedAt])
  @@index([category])
  @@map("project_techs")
}

model Credential {
  id          String     @id @default(uuid())
  projectId   String?    @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  username    String
  secretData  String     @map("secret_data")
  keyVersion  Int        @default(1) @map("key_version")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  deletedById String?    @map("deleted_by_id")
  auditLogs   AuditLog[]

  @@index([projectId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("credentials")
}

model Document {
  id            String    @id @default(uuid())
  projectId     String?   @map("project_id")
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name          String
  category      String    @default("General")
  mimeType      String    @map("mime_type")
  checksum      String?   @unique
  size          Int
  fileData      Bytes?    @map("file_data")
  storagePath   String?   @map("storage_path")
  storageBucket String?   @map("storage_bucket")
  clientVisible Boolean   @default(false) @map("client_visible")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedById   String?   @map("deleted_by_id")

  @@index([category])
  @@index([projectId])
  @@index([updatedAt])
  @@index([name])
  @@index([storagePath])
  @@index([deletedAt])
  @@map("documents")
}

model AuditLog {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  action       String
  credentialId String?     @map("credential_id")
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([credentialId])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserProfile {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  email             String             @unique
  displayName       String             @map("display_name")
  passwordHash      String?            @map("password_hash")
  passwordChangedAt DateTime?          @map("password_changed_at")
  age               Int?
  role              String             @default("ADMIN")
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  personalSecrets   PersonalSecret[]
  authTokens        AuthToken[]
  passkeys          Passkey[]
  emailMessages     EmailMessage[]
  pushSubscriptions PushSubscription[]
  assistantThreads  AssistantThread[]
  assistantMemories AssistantMemory[]
  assistantActions  AssistantAction[]
  assistantRoutines AssistantRoutine[]
  personalNotes     Note[]             @relation("PersonalNoteOwner")
  personalProjects  Project[]          @relation("PersonalProjectOwner")

  @@index([email])
  @@index([role, active])
  @@map("user_profiles")
}

model PushSubscription {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  endpoint   String      @unique
  p256dh     String
  auth       String
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  lastUsedAt DateTime?   @map("last_used_at")

  @@index([userId])
  @@index([updatedAt])
  @@map("push_subscriptions")
}

model EmailMessage {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  to        String
  subject   String
  body      String
  status    String      @default("draft")
  source    String      @default("manual")
  resendId  String?     @map("resend_id")
  error     String?
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([userId, status, updatedAt])
  @@index([sentAt])
  @@map("email_messages")
}

model Passkey {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  credentialId String      @unique @map("credential_id")
  publicKey    Bytes       @map("public_key")
  counter      Int         @default(0)
  transports   String[]    @default([])
  deviceType   String      @map("device_type")
  backedUp     Boolean     @default(false) @map("backed_up")
  createdAt    DateTime    @default(now()) @map("created_at")
  lastUsedAt   DateTime?   @map("last_used_at")

  @@index([userId])
  @@map("passkeys")
}

model AuthToken {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tokenHash String      @unique @map("token_hash")
  purpose   String
  expiresAt DateTime    @map("expires_at")
  usedAt    DateTime?   @map("used_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId, purpose, usedAt, expiresAt])
  @@map("auth_tokens")
}

model PersonalSecret {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name       String
  username   String?
  secretData String      @map("secret_data")
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt])
  @@map("personal_secrets")
}

model Invoice {
  id                String    @id @default(uuid())
  projectId         String?   @map("project_id")
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId          String?   @map("client_id")
  clientRef         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  number            String    @unique
  client            String
  amount            Float
  netAmount         Float?    @map("net_amount")
  taxRate           Float     @default(19) @map("tax_rate")
  currency          String    @default("CLP")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  status            String    @default("Pendiente")
  dueDate           DateTime  @map("due_date")
  paidAt            DateTime? @map("paid_at")
  notes             String?
  source            String    @default("MANUAL")
  product           String?
  externalReference String?   @unique @map("external_reference")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  payments          Payment[]

  @@index([status])
  @@index([projectId])
  @@index([clientId])
  @@index([createdAt])
  @@index([dueDate])
  @@index([client])
  @@index([source])
  @@index([deletedAt])
  @@map("invoices")
}

model Note {
  id              String       @id @default(uuid())
  projectId       String?      @map("project_id")
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visibility      String       @default("COMPANY")
  personalOwnerId String?      @map("personal_owner_id")
  personalOwner   UserProfile? @relation("PersonalNoteOwner", fields: [personalOwnerId], references: [userId], onDelete: Cascade)
  title           String
  slug            String?
  content         String       @default("")
  folder          String       @default("General")
  pinned          Boolean      @default(false)
  tags            String[]     @default([])
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  deletedById     String?      @map("deleted_by_id")
  revisions       NoteRevision[]
  outgoingLinks   NoteLink[]   @relation("NoteLinkSource")

  @@index([folder])
  @@index([projectId])
  @@index([visibility, personalOwnerId])
  @@index([slug])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([pinned])
  @@map("notes")
}

model Contact {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean   @default(false) @map("is_primary")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([clientId])
  @@index([email])
  @@index([deletedAt])
  @@map("contacts")
}

model Opportunity {
  id            String        @id @default(uuid())
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name          String
  company       String?
  contactName   String?       @map("contact_name")
  email         String?
  phone         String?
  stage         String        @default("Nuevo")
  source        String        @default("Directo")
  value         Float         @default(0)
  probability   Int           @default(10)
  expectedClose DateTime?     @map("expected_close")
  owner         String?
  nextAction    String?       @map("next_action")
  lostReason    String?       @map("lost_reason")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  activities    CrmActivity[]
  quotes        Quote[]

  @@index([stage])
  @@index([clientId])
  @@index([expectedClose])
  @@index([deletedAt])
  @@map("opportunities")
}

model CrmActivity {
  id            String      @id @default(uuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String      @default("Nota")
  subject       String
  details       String?
  dueAt         DateTime?   @map("due_at")
  completedAt   DateTime?   @map("completed_at")
  createdBy     String?     @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([opportunityId])
  @@index([dueAt, completedAt])
  @@map("crm_activities")
}

model Quote {
  id            String       @id @default(uuid())
  number        String       @unique
  clientId      String       @map("client_id")
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunityId String?      @map("opportunity_id")
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectId     String?      @map("project_id")
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  version       Int          @default(1)
  parentQuoteId String?      @map("parent_quote_id")
  parentQuote   Quote?       @relation("QuoteRevisions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions     Quote[]      @relation("QuoteRevisions")
  title         String
  status        String       @default("Borrador")
  currency      String       @default("CLP")
  taxRate       Float        @default(19) @map("tax_rate")
  discount      Float        @default(0)
  validUntil    DateTime?    @map("valid_until")
  terms         String?
  notes         String?
  sentAt        DateTime?    @map("sent_at")
  approvedAt    DateTime?    @map("approved_at")
  rejectedAt    DateTime?    @map("rejected_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  items         QuoteItem[]

  @@index([clientId])
  @@index([opportunityId])
  @@index([projectId])
  @@index([parentQuoteId])
  @@index([status])
  @@index([validUntil])
  @@index([deletedAt])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String   @map("quote_id")
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @map("unit_price")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([quoteId, sortOrder])
  @@map("quote_items")
}

model TeamMember {
  id             String              @id @default(uuid())
  userId         String?             @unique @map("user_id")
  name           String
  email          String?             @unique
  role           String              @default("Desarrollador")
  skills         String[]            @default([])
  weeklyCapacity Float               @default(40) @map("weekly_capacity")
  hourlyCost     Float               @default(0) @map("hourly_cost")
  billableRate   Float               @default(0) @map("billable_rate")
  monthlySalary  Float               @default(0) @map("monthly_salary")
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  assignments    ProjectAssignment[]
  timeEntries    TimeEntry[]
  absences       TeamAbsence[]
  assets         Asset[]
  payrollEntries PayrollEntry[]
  ownedProjects  Project[]

  @@index([active])
  @@index([deletedAt])
  @@map("team_members")
}

model ProjectAssignment {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  role         String     @default("Miembro")
  allocation   Float      @default(100)
  startDate    DateTime?  @map("start_date")
  endDate      DateTime?  @map("end_date")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([projectId, teamMemberId])
  @@index([teamMemberId])
  @@map("project_assignments")
}

model TimeEntry {
  id           String       @id @default(uuid())
  projectId    String       @map("project_id")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMemberId String       @map("team_member_id")
  teamMember   TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)
  taskId       String?      @map("task_id")
  task         ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  description  String
  date         DateTime
  hours        Float
  billable     Boolean      @default(true)
  approved     Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([projectId, date])
  @@index([teamMemberId, date])
  @@index([taskId])
  @@index([approved])
  @@map("time_entries")
}

model TeamAbsence {
  id           String     @id @default(uuid())
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  type         String     @default("Vacaciones")
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([teamMemberId, startDate, endDate])
  @@map("team_absences")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  taxId          String?         @map("tax_id")
  email          String?
  phone          String?
  category       String          @default("Servicios")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([deletedAt])
  @@map("suppliers")
}

model Expense {
  id          String    @id @default(uuid())
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  projectId   String?   @map("project_id")
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description String
  category    String    @default("General")
  amount      Float
  taxAmount   Float     @default(0) @map("tax_amount")
  currency    String    @default("CLP")
  date        DateTime
  status      String    @default("Pagado")
  receiptUrl  String?   @map("receipt_url")
  recurring   Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([projectId])
  @@index([supplierId])
  @@index([date])
  @@index([category])
  @@index([deletedAt])
  @@map("expenses")
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String   @default("CLP")
  method    String   @default("Transferencia")
  reference String?
  paidAt    DateTime @default(now()) @map("paid_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

model SupportContract {
  id              String          @id @default(uuid())
  clientId        String          @map("client_id")
